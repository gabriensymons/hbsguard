{
  "name": "hbsguard",
  "version": "0.2.0",
  "description": "Standalone Handlebars linter using plain Handlebars AST semantics.",
  "keywords": [
    "handlebars",
    "hbs",
    "lint",
    "linter",
    "templates"
  ],
  "author": "Gabrien Symons",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabriensymons/hbsguard.git"
  },
  "bugs": {
    "url": "https://github.com/gabriensymons/hbsguard/issues"
  },
  "homepage": "https://github.com/gabriensymons/hbsguard#readme",
  "main": "src/index.js",
  "bin": {
    "hbsguard": "bin/hbsguard.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:grammar": "node scripts/build-handlebars-grammar.js",
    "build:playground": "npm run build:grammar && node scripts/build-playground.js",
    "test": "node --test",
    "test:cli": "node --test test/cli.test.js",
    "test:unit": "node --test test/unit.test.js",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/common": "^1.5.2",
    "@lezer/generator": "^1.8.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.10",
    "esbuild": "^0.28.2"
  }
}
